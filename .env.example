# Google Sheets API v4, server-side only (PRD §4). Two auth options — set
# EITHER the service account key OR all three OAuth values, not both.
# Service account (recommended: doesn't expire, nothing to re-authorize):
GOOGLE_SERVICE_ACCOUNT_KEY=
# OAuth2 alternative (requires the consent screen set to "In production" —
# a refresh token from a "Testing" consent screen expires after 7 days):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Sheet: "Global Media & Creative - People Dashboard"
# https://docs.google.com/spreadsheets/d/1E4YUGNPP5tU7x8RudWV_T8tjx5o1p8UYF6YYQmoSEwg
GOOGLE_SHEET_ID=1E4YUGNPP5tU7x8RudWV_T8tjx5o1p8UYF6YYQmoSEwg

# Email send (Resend) — PRD §10.5, decide before Phase 7
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# YTD calculation anchor month (1-12). 4 = April, confirm with HRBP (PRD §5.4).
FY_START_MONTH=4

# Vercel deployment password gate (or use Vercel's built-in password protection instead)
DASHBOARD_ACCESS_PASSWORD=
