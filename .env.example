# Google Sheets API v4 — service account, server-side only (PRD §4)
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHEET_ID=

# Email send (Resend) — PRD §10.5, decide before Phase 7
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# YTD calculation anchor month (1-12). 4 = April, confirm with HRBP (PRD §5.4).
FY_START_MONTH=4

# Vercel deployment password gate (or use Vercel's built-in password protection instead)
DASHBOARD_ACCESS_PASSWORD=
